# Copy this file to ".env" and fill in your key.
#
# Get a FREE Gemini API key here (no credit card required):
# https://aistudio.google.com/app/apikey
#
GEMINI_API_KEY=your_free_gemini_api_key_here

# Port the backend server runs on
PORT=5000

# The origin your frontend is served from (for CORS). "*" allows any origin.
CLIENT_ORIGIN=*
